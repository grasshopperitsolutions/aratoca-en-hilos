# Firebase Configuration (Aratoca en Hilos)
# Copy to .env and fill with the values from the Firebase console:
# Project settings > General > Your apps > Web app > SDK setup and configuration
VITE_FIREBASE_API_KEY=your_firebase_api_key
VITE_FIREBASE_AUTH_DOMAIN=your_firebase_auth_domain
VITE_FIREBASE_PROJECT_ID=your_firebase_project_id
VITE_FIREBASE_STORAGE_BUCKET=your_firebase_storage_bucket
VITE_FIREBASE_MESSAGING_SENDER_ID=your_firebase_messaging_sender_id
VITE_FIREBASE_APP_ID=your_firebase_app_id

# App Check (reCAPTCHA v3 site key) - protects the public contact form
VITE_RECAPTCHA_SITE_KEY=your_recaptcha_v3_site_key

# Canonical origin used for SEO canonical URLs, hreflang, OG tags and sitemap.xml
VITE_SITE_ORIGIN=https://grasshoppersolutions.online
