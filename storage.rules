rules_version = '2';

// Aratoca en Hilos — Cloud Storage security rules.
//
// Uploads come straight from the browser, so these rules are the only limit on
// what lands in the bucket. Admin status is read from the same `admins/`
// allowlist the Firestore rules use, keeping one source of truth.
//
// Deploy with:  firebase deploy --only storage

service firebase.storage {
  match /b/{bucket}/o {

    function isAdmin() {
      return request.auth != null
        && firestore.exists(/databases/(default)/documents/admins/$(request.auth.uid));
    }

    // Matches ACCEPTED_TYPES and maxBytesFor() in src/services/archivos.ts.
    // Both files must change together: this is the enforcement, that is only
    // the error message.
    //
    // PDFs get a larger ceiling than images because the book is a print-quality
    // illustrated publication; 10 MB would reject it.
    function isImageUpload() {
      return request.resource.contentType.matches('image/(jpeg|png|webp|avif|svg\\+xml)')
        && request.resource.size <= 10 * 1024 * 1024;
    }

    function isPdfUpload() {
      return request.resource.contentType == 'application/pdf'
        && request.resource.size <= 50 * 1024 * 1024;
    }

    function isAllowedUpload() {
      return isImageUpload() || isPdfUpload();
    }

    // Media library, and artisan portraits chosen from it. Public read so the
    // images render for visitors; writes are admin-only.
    match /archivos/{file} {
      allow read: if true;
      allow create, update: if isAdmin() && isAllowedUpload();
      allow delete: if isAdmin();
    }

    // Portraits only — a PDF has no business being an artisan's photograph, so
    // this prefix stays images-only even though the library accepts both.
    match /artesanos/{file} {
      allow read: if true;
      allow create, update: if isAdmin() && isImageUpload();
      allow delete: if isAdmin();
    }

    // No other prefix is writable, so a stray SDK call cannot scatter objects
    // around the bucket.
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
